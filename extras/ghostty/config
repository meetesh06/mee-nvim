# Ghostty config to pair with the deepblue Neovim theme.
#
# Install (on the machine running ghostty):
#   macOS: ~/Library/Application Support/com.mitchellh.ghostty/config  (or ~/.config/ghostty/config)
#   Linux: ~/.config/ghostty/config
# plus the theme file extras/ghostty/deepblue -> <that dir>/themes/deepblue
# Reload with ctrl+shift+, (cmd+shift+, on macOS).

theme = deepblue

# Monaspace: Neon for code, Radon (handwriting style) for italics, so comments,
# inlay hints and git blame read clearly apart from code.
font-family = Monaspace Neon
font-family-italic = Monaspace Radon
font-family-bold-italic = Monaspace Radon
font-size = 13

# Monaspace ships its ligatures switched off; turn them on per group.
# (ghostty comments must be on their own line, not after a value)
# calt = texture healing (evens out letter spacing), liga = basic ligatures
# ss01 == === !=   ss02 <= >=      ss03 -> ~> <-   ss04 </ />
# ss06 ## ++ &&    ss07 :: :=      ss08 ..= .-     ss09 <=> ==>
font-feature = calt
font-feature = liga
font-feature = ss01
font-feature = ss02
font-feature = ss03
font-feature = ss04
font-feature = ss06
font-feature = ss07
font-feature = ss08
font-feature = ss09
