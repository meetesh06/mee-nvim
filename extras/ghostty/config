# Ghostty config to pair with the deepblue Neovim theme.
# Install with ./setup_ghostty.sh (copies this and the deepblue theme into place).
# Reload with ctrl+shift+, (cmd+shift+, on macOS).

window-decoration = false
shell-integration-features = ssh-env,ssh-terminfo

clipboard-read = allow
clipboard-write = allow
clipboard-paste-protection = false

# super is cmd on macOS and the Super/Windows key on Linux.
keybind = super+h=goto_split:left
keybind = super+l=goto_split:right
keybind = super+k=goto_split:up
keybind = super+j=goto_split:down

keybind = super+shift+h=resize_split:left,10
keybind = super+shift+l=resize_split:right,10
keybind = super+shift+k=resize_split:up,10
keybind = super+shift+j=resize_split:down,10

theme = deepblue

# Monaspace: Neon for code, Radon (handwriting style) for italics, so comments,
# inlay hints and git blame read clearly apart from code.
font-family = Monaspace Neon
font-family-italic = Monaspace Radon
font-family-bold-italic = Monaspace Radon
font-size = 13

# Monaspace ships its ligatures switched off; turn them on per group.
# (ghostty comments must be on their own line, not after a value)
# calt = texture healing (evens out letter spacing), liga = basic ligatures
# ss01 == === !=   ss02 <= >=      ss03 -> ~> <-   ss04 </ />
# ss06 ## ++ &&    ss07 :: :=      ss08 ..= .-     ss09 <=> ==>
font-feature = calt
font-feature = liga
font-feature = ss01
font-feature = ss02
font-feature = ss03
font-feature = ss04
font-feature = ss06
font-feature = ss07
font-feature = ss08
font-feature = ss09
